# Original exam material is immutable and versioned via Git LFS.

# Full staged datasets are generated locally. Track only documentation/manifests.
dataset/staged/*.json
!dataset/staged/*.manifest.json
!dataset/staged/README.md

# Python caches, tooling, and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Build and packaging output
build/
dist/
*.egg-info/

# Local configuration and editor files
.env
.env.*
!.env.example
.idea/
.vscode/
*.swp
*~

# Operating-system metadata
.DS_Store
Thumbs.db
